<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D1D5DB"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvKeyboardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="کیبورد شیر و خورشید (نسخه اولیه)"
        android:gravity="center"
        android:textColor="#374151"
        android:textSize="12sp"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnKeyA"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ا"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnKeyB"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ب"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnKeyC"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="پ"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnKeySpace"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:layout_margin="2dp"
            android:text="فاصله"
            android:textSize="14sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnKeyDelete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="⌫"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#E5E7EB" />

        <Button
            android:id="@+id/btnKeyEnter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="↵"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A73E8" />

    </LinearLayout>

</LinearLayout>
